# Kopiere diese Datei nach .env und trage deinen TMDB-Lesezugriffstoken ein.
# Den Token findest du unter https://www.themoviedb.org/settings/api ("API-Lesezugriffstoken").
TMDB_READ_TOKEN=

# Optional: anderes Datenverzeichnis (Standard: ./data)
# FILMZWILLING_DATA_DIR=./data

# Optional: zusätzliche CA-Datei für den MovieLens-Download (siehe README, Abschnitt "Zertifikatsfehler")
# FILMZWILLING_CA_BUNDLE=
